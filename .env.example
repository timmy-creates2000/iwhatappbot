# ── Database (Turso) ──────────────────────────────────────────────────────────
#
# Get these from your Turso dashboard:
#   1. Install Turso CLI: https://docs.turso.tech/cli/introduction
#   2. Run: turso db create commgrowth
#   3. Run: turso db show commgrowth   → copy the URL
#   4. Run: turso db tokens create commgrowth  → copy the token
#
# OR go to https://app.turso.tech → your database → Connect
#
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── API Server ────────────────────────────────────────────────────────────────

PORT=8080

# Password that protects the entire app (QR code, all API routes)
# Use a strong random string
APP_PASSWORD=change-me-in-production

# ── Frontend (Vite) ───────────────────────────────────────────────────────────

BASE_PATH=/

# ── Optional ──────────────────────────────────────────────────────────────────

# Google Gemini API key for AI message composition
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Restrict CORS to your frontend origin in production
# Example: https://yourdomain.com  — leave blank in dev to allow all
ALLOWED_ORIGIN=

LOG_LEVEL=info
NODE_ENV=development
